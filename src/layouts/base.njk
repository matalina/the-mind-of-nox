<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{{ title }} — The Mind of Nox</title>
    {% if env.isProduction %}
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4RY54NSYKG"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-4RY54NSYKG');
    </script>
    {% endif %}
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600&family=Patrick+Hand&family=Schoolbell&family=Shadows+Into+Light&family=IM+Fell+English+SC&family=IM+Fell+DW+Pica:ital@0;1&display=swap" rel="stylesheet"/>
    <link rel="alternate" type="application/rss+xml" title="The Mind of Nox" href="/feed/index.xml"/>
    <link rel="stylesheet" href="/css/fontawesome.min.css"/>
    <link rel="stylesheet" href="/css/main.css"/>
  </head>
  <body>
    {% set u = page.url %}
    <header class="site-header">
      <div class="container">
        <div class="iconbar iconbar--header">
          {% for s in social.header %}
          <a class="iconbar__link" href="{{ s.url }}" aria-label="{{ s.label }}" title="{{ s.label }}"{% if s.url[0] != '/' and s.url[0] != '#' and 'mailto:' not in s.url %} target="_blank" rel="noopener"{% endif %}>
            <img src="/images/icons/{{ s.icon }}" alt="{{ s.label }}" width="20" height="20"/>
          </a>
          {% endfor %}
        </div>
        <h1 class="masthead"><a href="/"><img class="masthead__logo" src="/images/logo.jpg" alt="Nightmare Journal: The Mind of Nox" width="1282" height="363"/></a></h1>
        <nav class="mainnav">
          {% set firstPage = '/notebook/01/001/' %}
          <a href="/"{% if u == '/' %} class="active"{% endif %}>Home</a>
          <a href="/notebooks/"{% if (u.startsWith('/notebook') and u != firstPage) %} class="active"{% endif %}>The Notebooks</a>
          <a href="{{ firstPage }}"{% if u == firstPage %} class="active"{% endif %}>Page 1</a>
          <a href="/nox-knight/"{% if u.startsWith('/nox-knight') %} class="active"{% endif %}>Nox Knight</a>
          <a href="/aj-hunter/"{% if u.startsWith('/aj-hunter') %} class="active"{% endif %}>AJ Hunter</a>
        </nav>
      </div>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-mark">The Mind of Nox</div>
        <div class="footer-mid">Last updated <time datetime="{{ build.iso }}">{{ build.formatted }} UTC</time></div>
        <div class="footer-credit">Background photo by <a href="https://unsplash.com/@jorok" target="_blank" rel="noopener">Georgi Kalaydzhiev</a> on <a href="https://unsplash.com/photos/a-large-empty-field-c-RE_QuyuFc" target="_blank" rel="noopener">Unsplash</a></div>
        <div class="iconbar iconbar--footer">
          {% for s in social.footer %}
          <a class="iconbar__link" href="{{ s.url }}" aria-label="{{ s.label }}" title="{{ s.label }}" target="_blank" rel="noopener">
            <img src="/images/icons/{{ s.icon }}" alt="{{ s.label }}" width="22" height="22"/>
          </a>
          {% endfor %}
        </div>
      </div>
    </footer>
  </body>
</html>
