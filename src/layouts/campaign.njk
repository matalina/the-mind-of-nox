---
layout: base.njk
---
<div class="article-wrap">
  <div class="breadcrumb">
    <a href="/">Home</a> &nbsp;/&nbsp; <a href="/lore/">Lore</a> &nbsp;/&nbsp;
    <span class="here">{{ title }}</span>
  </div>

  <div class="entry-head">
    <div class="kicker">Igniting the Spark</div>
    <h1 class="entry-title">{{ title }}</h1>
  </div>

  <div class="layout">
    <article>
      <div class="prose">{{ content | safe }}</div>
    </article>

    <aside class="aside">
      <div class="panel related">
        <div class="panel__label panel__label--plain">Chapters</div>
        {% for p in collections.campaign %}
          <a href="{{ p.url }}"{% if p.url == page.url %} class="current"{% endif %}>{{ p.data.title }} →</a>
        {% endfor %}
      </div>
      {% if hasToc %}
        <div class="panel">
          <div class="panel__label panel__label--plain">In This Note</div>
          <div class="toc-panel">{{ content | toc({ tags: tocTags }) | safe }}</div>
        </div>
      {% endif %}
    </aside>
  </div>
</div>
