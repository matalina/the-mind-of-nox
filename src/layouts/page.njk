---
layout: base.njk
---
{#- A standalone page. `paper: true` puts it on a notebook page (in-world);
    otherwise it uses the plain site style (out-of-world). -#}
{% if paper %}
<article class="sheet sheet--page hand--{{ hand or 'adult' }}">
  <h1 class="sheet__title">{{ title }}</h1>
  <div class="sheet__body">{{ content | safe }}</div>
</article>
{% else %}
<article class="plain">
  <h1 class="plain__title">{{ title }}</h1>
  <div class="plain__body">{{ content | safe }}</div>
</article>
{% endif %}
