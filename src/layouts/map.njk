---
layout: base.njk
---
<div class="article-wrap">
  <div class="breadcrumb">
    <a href="/">Home</a> &nbsp;/&nbsp; <a href="/maps/old-new-york/">Maps</a> &nbsp;/&nbsp;
    <span class="here">{{ title }}</span>
  </div>

  <div class="entry-head">
    <div class="kicker">Maps</div>
    <h1 class="entry-title">{{ title }}</h1>
  </div>

  <div class="layout">
    <article>
      <div class="prose">{{ content | safe }}</div>
    </article>

    <aside class="aside">
      {% for group in collections.mapGroups %}
        <div class="panel related">
          <div class="panel__label panel__label--plain">{{ group.title }}</div>
          {% for p in group.pages %}
            <a href="{{ p.url }}"{% if p.url == page.url %} class="current"{% endif %}>{{ p.data.title }} →</a>
          {% endfor %}
        </div>
      {% endfor %}
      {% if hasToc %}
        <div class="panel">
          <div class="panel__label panel__label--plain">In This Note</div>
          <div class="toc-panel">{{ content | toc({ tags: tocTags }) | safe }}</div>
        </div>
      {% endif %}
    </aside>
  </div>
</div>
