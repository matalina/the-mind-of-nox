---
layout: base.njk
title: Home
---
<section class="home">
  <h1>The Mind of Nox</h1>

  <h2>Recent sessions</h2>
  {% if collections.sessions | length %}
    <ul class="session-list">
      {% for s in collections.sessions %}
        <li>
          <a href="{{ s.url }}">{{ s.data.title }}</a>
          {% if s.date %}<span class="muted">— {{ s.date | longDate }}</span>{% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>No sessions synced yet. Run <code>npm run sync</code>.</p>
  {% endif %}

  <h2>Sections</h2>
  {% for section in collections.sections %}
    <section class="section-group">
      <h3>{{ section.title }}</h3>
      <ul>
        {% for p in section.pages %}
          <li><a href="{{ p.url }}">{{ p.data.title }}</a></li>
        {% endfor %}
      </ul>
    </section>
  {% endfor %}
</section>
