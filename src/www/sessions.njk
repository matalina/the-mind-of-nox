---
layout: base.njk
title: Sessions
pagination:
  data: collections.sessions
  size: 9
  alias: posts
permalink: "/sessions/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---
<div class="article-wrap">
  <div class="breadcrumb"><a href="/">Home</a> &nbsp;/&nbsp; <span class="here">Sessions</span></div>
  <div class="entry-head">
    <div class="kicker">Chorari Ledger</div>
    <h1 class="entry-title">Sessions</h1>
    <p class="lede">The daybook — every entry from the Iron Veil, newest first.</p>
  </div>
</div>

<section class="section">
  <div class="grid">
    {% for s in posts %}
      <a href="{{ s.url }}" class="card">
        <div class="card__top">
          <span class="chip chip--iron">Session</span>
          <span class="card__tag">Session {{ s.data.session }}</span>
        </div>
        <h4 class="card__title">{{ s.data.title }}</h4>
        <p class="card__excerpt">{{ s.templateContent | plainExcerpt(140) }}</p>
        <span class="card__date">{{ s.date | longDate }}</span>
      </a>
    {% else %}
      <p>No sessions yet. Run <code>npm run sync</code>.</p>
    {% endfor %}
  </div>

  {% if pagination.pages.length > 1 %}
    <nav class="pager">
      {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">← Newer</a>{% else %}<span></span>{% endif %}
      <span>Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
      {% if pagination.href.next %}<a href="{{ pagination.href.next }}">Older →</a>{% else %}<span></span>{% endif %}
    </nav>
  {% endif %}
</section>
