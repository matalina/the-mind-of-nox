# Copy this file to .env and fill in what you use. .env never goes to GitHub.
# Anything left blank is skipped.

# The site's public address, used for links in previews, the feed and posts.
NOX_SITE_URL=https://themindofnox.com

# Dabble: an API key from Connected Apps (Read and plan), on the account that
# owns Breaking the Cycle.
DABBLE_API_KEY=

# Discord: Channel settings → Integrations → Webhooks → New Webhook → Copy URL.
DISCORD_WEBHOOK_URL=

# Bluesky: your handle, and an app password (Settings → Privacy and security
# → App passwords). Not your real password.
BLUESKY_HANDLE=themindofnox.com
BLUESKY_APP_PASSWORD=

# Facebook Page and Instagram (Business or Creator, linked to the Page),
# both through one Meta developer app and a Page access token.
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
META_PAGE_TOKEN=
